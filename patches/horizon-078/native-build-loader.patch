+diff --git a/packaging/android/java/dev/horizon/android/NativeMods.java b/packaging/android/java/dev/horizon/android/NativeMods.java
+new file mode 100644
+--- /dev/null
++++ b/packaging/android/java/dev/horizon/android/NativeMods.java
